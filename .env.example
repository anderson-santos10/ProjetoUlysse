# Copie para .env e ajuste. Não commite o arquivo .env.
#
# O Django lê exatamente a variável SECRET_KEY.
# Em produção (Railway → Variables) ela é obrigatória. Deixe o valor vazio
# neste exemplo; nunca coloque a chave real neste arquivo.

SECRET_KEY=

# Desenvolvimento local:
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
#
# Produção / Railway:
# DEBUG=False
# ALLOWED_HOSTS=seu-dominio.com,.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://seu-dominio.com,https://seu-servico.up.railway.app
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
#
# Banco: sem Postgres configurado, o Django usa SQLite (db.sqlite3).
# No Railway, use as Variables do plugin (não coloque senha neste arquivo):
# DATABASE_URL=
# PGHOST=
# PGDATABASE=
# PGUSER=
# PGPASSWORD=
# PGPORT=
